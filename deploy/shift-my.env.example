# Copy to /etc/shift-my/shift-my.env and replace the example values.
SHIFT_MY_PUBLIC_HOST=lab.example.com
SHIFT_MY_PUBLIC_IPV4=203.0.113.10
SHIFT_MY_DB_PATH=/var/lib/shift-my/state.db
SHIFT_MY_CA_CERT=/etc/shift-my/root-ca.pem
SHIFT_MY_CA_KEY=/etc/shift-my/root-ca-key.pem
SHIFT_MY_PUBLIC_CERT=/etc/letsencrypt/live/lab.example.com/fullchain.pem
SHIFT_MY_PUBLIC_KEY=/etc/letsencrypt/live/lab.example.com/privkey.pem
SHIFT_MY_CAPTURE_ENABLED=false
SHIFT_MY_CAPTURE_DIR=/var/lib/shift-my/captures
